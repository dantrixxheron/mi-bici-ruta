{
  "name": "miruta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Planeador de rutas multimodales para MiBici que respeta la ventana gratuita de 30 minutos",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "datos:estaciones": "tsx scripts/01-normalizar-estaciones.ts",
    "datos:grafo": "tsx scripts/02-construir-grafo.ts",
    "datos": "npm run datos:estaciones && npm run datos:grafo",
    "probar:motor": "tsx scripts/03-probar-motor.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.0.3"
  }
}
